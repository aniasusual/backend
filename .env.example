# =============================================================================
# Lowkey Backend Environment Configuration
# =============================================================================

# Server Binding
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Ollama LLM Connection
OLLAMA_HOST=http://127.0.0.1:11434
DEFAULT_MODEL_ID=qwen2.5-coder:7b

# Storage & Cache Paths (defaults to ~/.lowkey/... if left empty)
PROJECTS_ROOT=~/.lowkey/projects
TEMPLATE_CACHE_DIR=~/.lowkey/template_cache

# CORS Allowed Origins (comma-separated, or * for all)
CORS_ORIGINS=*

# Asset Provider API Keys (Optional)
UNSPLASH_ACCESS_KEYS=
PEXELS_ACCESS_KEYS=
